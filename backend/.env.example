# Copy to .env and fill in a real key. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# PostgreSQL (primary): postgresql+psycopg://aivoa:aivoa@localhost:5432/aivoa_rca
# Leave unset to use the local SQLite fallback (aivoa.db) for development only.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
